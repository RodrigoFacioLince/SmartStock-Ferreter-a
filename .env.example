# Backend: Supabase project URL from the Connect dialog.
SUPABASE_URL=

# Backend: Project Settings > API Keys > Publishable key.
SUPABASE_PUBLISHABLE_KEY=

# Backend only: Project Settings > API Keys > Secret key.
SUPABASE_SECRET_KEY=

# Copy these public values to frontend/.env. VITE_ variables are browser-visible.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The backend validates access tokens through Supabase Auth's get_user endpoint.
# SUPABASE_JWKS_URL is therefore not required by this implementation.
